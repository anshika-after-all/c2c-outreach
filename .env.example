# Copy to .env and fill in your own values. Do not commit .env.

# LinkedIn login. Leave blank to type them in the browser during option 2.
LINKEDIN_EMAIL=
LINKEDIN_PASSWORD=

# Gmail app password, not the normal account password.
GMAIL_EMAIL=
GMAIL_APP_PASSWORD=

# Hidden copy of each outreach email. Optional.
ADMIN_EMAIL=

# Resume rewrite tries Gemini, then Groq, then OpenRouter.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Follow-up sentences use OpenRouter.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
